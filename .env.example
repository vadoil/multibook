# Путь к файлу базы SQLite
DATABASE_PATH=./data/multibook.db

# Публичный адрес сайта
SITE_URL=http://localhost:3000

# Каталог Tilda Store, из которого импортируются товары
TILDA_STOREPART=341682625071
TILDA_RECID=639786271

# Уведомления о новых заказах в Telegram (бот от @BotFather; chat_id — чат или канал менеджеров)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Оплата ЮKassa. Без ключей — демо-оплата (деньги не списываются).
# В продакшене без ключей оплата скрыта; демо там включается только явно: DEMO_PAYMENTS=1
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
DEMO_PAYMENTS=
# Чеки 54-ФЗ через кассу ЮKassa: 1 — отправлять; код НДС: 1 без НДС, 2 — 0%, 4 — 20/120 и т.д.
YOOKASSA_RECEIPTS=
YOOKASSA_VAT_CODE=1

# Доставка СДЭК (API v2). Без ключей — демо-расчёт по формуле.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# 1 — тестовый контур api.edu.cdek.ru
CDEK_TEST=
# Город отправки, код СДЭК (44 — Москва)
CDEK_FROM_CITY_CODE=44

# Этап 4: ИИ-роутер для контент-завода (OpenAI-совместимый API)
AI_ROUTER_BASE_URL=
AI_ROUTER_API_KEY=

# Контент-завод: ИИ-роутер (OpenAI-совместимый)
NORDROUTER_API_KEY=
NORDROUTER_BASE_URL=https://nordrouter.com/v1
NORDROUTER_MODEL=anthropic/claude-opus-5.5
# Публикация утверждённых материалов
TELEGRAM_CHANNEL_ID=
VK_ACCESS_TOKEN=
VK_GROUP_ID=
# Остатки с маркетплейсов (ключи только на чтение)
OZON_CLIENT_ID=
OZON_API_KEY=
WB_API_TOKEN=
